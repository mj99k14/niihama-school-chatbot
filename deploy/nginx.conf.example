# /etc/nginx/sites-available/niihama-chatbot
# 사용 전 YOUR_DOMAIN을 실제 도메인으로 바꾸고,
# /home/ubuntu/niihama_chatbot 경로를 실제 클론 경로에 맞게 바꿀 것.
#
# 적용:
#   sudo ln -s /etc/nginx/sites-available/niihama-chatbot /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d YOUR_DOMAIN   # HTTPS 발급 (자동으로 이 파일을 443으로 확장해줌)

server {
    listen 80;
    server_name YOUR_DOMAIN;

    root /home/ubuntu/niihama_chatbot/dist;
    index index.html;

    # 백엔드 API 경로만 FastAPI(127.0.0.1:8000)로 프록시.
    # 프론트 빌드 시 VITE_API_BASE_URL을 빈 값("")으로 둬서
    # 같은 오리진(/chat 등)으로 요청하게 만들었기 때문에 CORS 설정이 필요 없다.
    location ~ ^/(health|categories|chat|suggested-questions|sources|document|feedback) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # /chat 은 스트리밍 응답이므로 버퍼링을 꺼야 실시간으로 흘러나간다.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # 프론트 정적 파일 (React SPA, 클라이언트 라우팅 없음 -> 단순 정적 서빙)
    location / {
        try_files $uri /index.html;
    }
}
